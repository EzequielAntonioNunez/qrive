{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "axyro-sim-lab-local",
  "main": "worker/local.ts",
  "compatibility_date": "2026-10-05",
  "d1_databases": [{ "binding": "DB", "database_name": "axyro-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "axyro-files" }],
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "axyro-events" }],
    "consumers": [{ "queue": "axyro-events", "max_batch_timeout": 1 }]
  }
}
