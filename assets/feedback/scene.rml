      <!-- Check que se dibuja después del anillo. -->
      <KeyedObject objectId="0:12"><KeyedProperty propertyKey="115">
        <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
        <KeyFrameDouble value="0" frame="10" interpolationType="cubic"><CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="1" frame="28"/>
      </KeyedProperty></KeyedObject>
      <!-- Destello suave: un halo que se expande y se apaga. -->
      <KeyedObject objectId="0:14">
        <KeyedProperty propertyKey="18">
          <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
          <KeyFrameDouble value="0" frame="14" interpolationType="cubic"><CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1"/></KeyFrameDouble>
