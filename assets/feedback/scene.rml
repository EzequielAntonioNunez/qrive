      <Shape name="Disco">
        <Ellipse width="160" height="160" name="Trazo"/>
        <Fill name="Relleno">
          <RadialGradient startX="0" startY="-40" endX="0" endY="80" name="Degradado">
            <GradientStop colorValue="F0003865" position="0"/>
            <GradientStop colorValue="F0001A33" position="1"/>
          </RadialGradient>
        </Fill>
        <Stroke thickness="5" name="Pista"><SolidColor colorValue="33D9785A" name="Color"/></Stroke>
      </Shape>
      <Shape opacity="0" name="Destello" id="0:34">
        <Ellipse width="210" height="210" name="Trazo"/>
        <Fill name="Relleno">
          <RadialGradient startX="0" startY="0" endX="105" endY="0" name="Degradado">
            <GradientStop colorValue="00D9785A" position="0.62"/>
            <GradientStop colorValue="4DD9785A" position="0.78"/>
            <GradientStop colorValue="00D9785A" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>
    </Node>

    <StateMachine name="Feedback" id="0:100">
      <StateMachineTrigger name="best" id="0:101"/>
      <StateMachineTrigger name="acceptable" id="0:102"/>
      <StateMachineTrigger name="poor" id="0:103"/>

      <!-- Una sola capa: cualquier trigger interrumpe lo que se esté mostrando; al acabar, vuelve a Oculto. -->
      <StateMachineLayer name="Feedback" id="0:110">
        <AnyState x="0" y="-160">
          <StateTransition stateToId="0:112"><TransitionTriggerCondition inputId="0:101"/></StateTransition>
          <StateTransition stateToId="0:113"><TransitionTriggerCondition inputId="0:102"/></StateTransition>
          <StateTransition stateToId="0:114"><TransitionTriggerCondition inputId="0:103"/></StateTransition>
        </AnyState>
        <ExitState x="600" y="-160"/>
        <EntryState x="-200" y="0"><StateTransition stateToId="0:111"/></EntryState>
        <AnimationState x="0" y="0" animationId="0:200" id="0:111"/>
        <AnimationState x="300" y="-120" animationId="0:201" reset="true" id="0:112">
          <StateTransition stateToId="0:111" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
        <AnimationState x="300" y="0" animationId="0:202" reset="true" id="0:113">
          <StateTransition stateToId="0:111" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
        <AnimationState x="300" y="120" animationId="0:203" reset="true" id="0:114">
          <StateTransition stateToId="0:111" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
      </StateMachineLayer>
    </StateMachine>

    <!-- Oculto: estado inicial y de reposo; nada visible. -->
    <LinearAnimation loopValue="loop" duration="30" name="Oculto" id="0:200">
      <KeyedObject objectId="0:10"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:20"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:30"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0"/></KeyedProperty></KeyedObject>
    </LinearAnimation>

    <!--
      Línea de tiempo común (60 fps, 114 fotogramas = 1,9 s):
      0-26 entrada (escala 0,55 → 1,08 → 0,98 → 1 y fundido de entrada), 26-96 se mantiene, 96-114 fundido de salida.
    -->
    <LinearAnimation duration="114" name="Mejor" id="0:201">
      <KeyedObject objectId="0:20"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0"/></KeyedProperty></KeyedObject>
