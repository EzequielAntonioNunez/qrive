<Rive version="1" kind="fragment">
  <!--
    Feedback de decisión superpuesto en Unity cuando el participante elige una opción.
    Contrato con Unity: artboard "Feedback" (240x240), máquina de estados "Feedback",
    entradas de tipo trigger "best", "acceptable" y "poor" (los valores de `quality` del escenario).
    La valoración es de la decisión, nunca de la persona: iconografía sobria, sin texto ni rojo alarmista.
    Cada trigger reproduce una animación de un solo disparo (1,9 s): entrada de ~400 ms con rebote leve,
    se mantiene ~1,2 s y sale con fundido; al terminar la máquina vuelve sola al estado "Oculto".
    Paleta UFV: tinta #001A33, azul #003865, acento #649EFF, blanco; verde #3FB68B, ámbar #E0A84A, terracota #D9785A.
    En Rive el primer elemento declarado se dibuja encima: el primer plano va antes que el fondo.
  -->
  <Artboard defaultStateMachineId="0:100" width="240" height="240" name="Feedback" id="0:2">

    <!-- Decisión óptima: check verde que se dibuja dentro de un anillo que se traza. -->
    <Node x="120" y="120" opacity="0" name="Mejor" id="0:10">
      <Shape name="Check" id="0:11">
        <PointsPath isClosed="false" name="Trazo">
          <StraightVertex x="-31" y="2"/>
          <StraightVertex x="-10" y="23"/>
          <StraightVertex x="33" y="-22"/>
        </PointsPath>
        <Stroke thickness="13" cap="round" join="round" name="Contorno">
          <SolidColor colorValue="FF3FB68B" name="Color"/>
          <TrimPath start="0" end="1" name="Recorte" id="0:12"/>
        </Stroke>
      </Shape>
      <Shape name="Anillo">
        <Ellipse width="160" height="160" name="Trazo"/>
        <Stroke thickness="5" cap="round" name="Contorno">
          <SolidColor colorValue="FF3FB68B" name="Color"/>
          <TrimPath start="0" end="1" name="Recorte" id="0:13"/>
        </Stroke>
      </Shape>
      <Shape name="Disco">
        <Ellipse width="160" height="160" name="Trazo"/>
        <Fill name="Relleno">
          <RadialGradient startX="0" startY="-40" endX="0" endY="80" name="Degradado">
            <GradientStop colorValue="F0003865" position="0"/>
            <GradientStop colorValue="F0001A33" position="1"/>
          </RadialGradient>
        </Fill>
        <Stroke thickness="5" name="Pista"><SolidColor colorValue="333FB68B" name="Color"/></Stroke>
      </Shape>
      <Shape opacity="0" name="Destello" id="0:14">
        <Ellipse width="210" height="210" name="Trazo"/>
        <Fill name="Relleno">
          <RadialGradient startX="0" startY="0" endX="105" endY="0" name="Degradado">
            <GradientStop colorValue="003FB68B" position="0.62"/>
            <GradientStop colorValue="803FB68B" position="0.78"/>
            <GradientStop colorValue="003FB68B" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>
    </Node>

    <!-- Decisión aceptable: signo «≈» ámbar (dos ondas que se dibujan a la vez). -->
    <Node x="120" y="120" opacity="0" name="Aceptable" id="0:20">
      <Shape name="Aproximado" id="0:21">
        <PointsPath isClosed="false" name="Onda superior">
          <StraightVertex x="-30" y="-6"/>
          <CubicMirroredVertex x="-13" y="-17" rotation="0" distance="9"/>
          <CubicMirroredVertex x="13" y="-5" rotation="0" distance="9"/>
          <StraightVertex x="30" y="-16"/>
        </PointsPath>
        <PointsPath isClosed="false" name="Onda inferior">
          <StraightVertex x="-30" y="16"/>
          <CubicMirroredVertex x="-13" y="5" rotation="0" distance="9"/>
          <CubicMirroredVertex x="13" y="17" rotation="0" distance="9"/>
          <StraightVertex x="30" y="6"/>
        </PointsPath>
        <Stroke thickness="11" cap="round" join="round" name="Contorno">
          <SolidColor colorValue="FFE0A84A" name="Color"/>
          <TrimPath start="0" end="1" modeValue="synchronized" name="Recorte" id="0:22"/>
        </Stroke>
      </Shape>
      <Shape name="Anillo">
        <Ellipse width="160" height="160" name="Trazo"/>
        <Stroke thickness="5" cap="round" name="Contorno">
          <SolidColor colorValue="FFE0A84A" name="Color"/>
          <TrimPath start="0" end="1" name="Recorte" id="0:23"/>
        </Stroke>
      </Shape>
      <Shape name="Disco">
        <Ellipse width="160" height="160" name="Trazo"/>
        <Fill name="Relleno">
          <RadialGradient startX="0" startY="-40" endX="0" endY="80" name="Degradado">
            <GradientStop colorValue="F0003865" position="0"/>
            <GradientStop colorValue="F0001A33" position="1"/>
          </RadialGradient>
        </Fill>
        <Stroke thickness="5" name="Pista"><SolidColor colorValue="33E0A84A" name="Color"/></Stroke>
      </Shape>
      <Shape opacity="0" name="Destello" id="0:24">
        <Ellipse width="210" height="210" name="Trazo"/>
        <Fill name="Relleno">
          <RadialGradient startX="0" startY="0" endX="105" endY="0" name="Degradado">
            <GradientStop colorValue="00E0A84A" position="0.62"/>
            <GradientStop colorValue="66E0A84A" position="0.78"/>
            <GradientStop colorValue="00E0A84A" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>
    </Node>

    <!-- Decisión mejorable: signo de exclamación sobrio en terracota apagado (no alarmista). -->
    <Node x="120" y="120" opacity="0" name="Mejorable" id="0:30">
      <Shape y="-12" name="Barra" id="0:31">
        <Rectangle width="12" height="44" cornerRadiusTL="6" name="Trazo"/>
        <Fill name="Relleno"><SolidColor colorValue="FFD9785A" name="Color"/></Fill>
      </Shape>
      <Shape y="28" name="Punto" id="0:32">
        <Ellipse width="13" height="13" name="Trazo"/>
        <Fill name="Relleno"><SolidColor colorValue="FFD9785A" name="Color"/></Fill>
      </Shape>
      <Shape name="Anillo">
        <Ellipse width="160" height="160" name="Trazo"/>
        <Stroke thickness="5" cap="round" name="Contorno">
          <SolidColor colorValue="FFD9785A" name="Color"/>
          <TrimPath start="0" end="1" name="Recorte" id="0:33"/>
        </Stroke>
