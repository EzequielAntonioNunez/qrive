{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "axyro-sim-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "axyro.qhel.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El Worker atiende todo (API, simulador y páginas HTML de la consola, para añadir cabeceras de seguridad)
    // salvo los ficheros con hash de Vite, la marca y las locuciones, que salen directos de los static assets.
    // /voz/: locuciones del guion público de VictorIA para la vista móvil (mismos WAV que Unity).
    "run_worker_first": ["/*", "!/assets/*", "!/brand/*", "!/voz/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "axyro-db", "database_id": "a6f26406-0082-4f70-8550-63535822a104", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "axyro-files", "jurisdiction": "eu" }],
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "axyro-events" }],
    "consumers": [{ "queue": "axyro-events", "max_batch_timeout": 1 }]
  },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "VOICE_LIMITER", "namespace_id": "1004", "simple": { "limit": 6, "period": 60 } },
    // Modo IA en vivo: subidas, partidas, situaciones y respuestas por instructor.
    { "name": "AI_LIMITER", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
    // Modo IA en vivo: claves temporales de voz TTS (una por WebSocket) por instructor.
    { "name": "TTS_LIMITER", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
  // Workers AI: Clef (modelo de decisión) interpreta la respuesta libre por voz entre las opciones de la fase.
  // Modo IA en vivo (flag ai_live_demo): además bge-m3 (embeddings), gpt-oss-120b (texto) y toMarkdown (PDF/DOCX).
  "ai": { "binding": "AI" },
  "vars": {
    "RETENTION_DAYS": "365",
    "AUDIT_RETENTION_DAYS": "730",
    // ai_live_demo: «Modo IA en vivo (demo)», solo instructores (worker/ai-routes.ts).
    "FEATURE_FLAGS": "{\"phase_timers\":true,\"ai_characters\":false,\"realtime_websocket\":true,\"ai_live_demo\":true}",
    // ACCESS_CODE_PEPPER y BOOTSTRAP_OWNER_EMAIL se configuran como secretos del Worker.
    // La autenticación pública usa correo y código propio; Cloudflare Access no participa.
    // Durable Objects de sesión en la UE (RGPD). Cambiarlo deja inaccesibles las sesiones creadas con el valor anterior.
    "SESSIONS_JURISDICTION": "eu",
    // Región del proyecto Soniox cuya clave está en el secreto SONIOX_API_KEY (voz del simulador web).
    // «us»: transferencia internacional avisada al participante antes de abrir el micrófono; «eu» al disponer de proyecto UE.
    "SONIOX_REGION": "us"
  }
}
